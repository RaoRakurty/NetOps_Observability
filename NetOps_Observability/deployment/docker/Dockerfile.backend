# Multi-stage build for the Go API.
#
# Stage 1 compiles a fully static binary so the runtime image can be
# distroless / scratch. Stage 2 ships only the binary, the CA bundle,
# and a non-root user.

# Pinned to a patched Go toolchain: govulncheck flagged a batch of stdlib CVEs
# (crypto/tls, crypto/x509, net/http, html/template, …) present in go1.24 and
# fixed by go1.25.12 (GO-2026-5856 crypto/tls). Keep this at or above the latest patched minor.
FROM golang:1.25.12-alpine@sha256:56961d79ea8129efddcc0b8643fd8a5416b4e6228cfd477e3fd61deb2672c587 AS build
WORKDIR /src
COPY src/backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/api .

FROM gcr.io/distroless/static-debian12:nonroot@sha256:d093aa3e30dbadd3efe1310db061a14da60299baff8450a17fe0ccc514a16639
COPY --from=build /out/api /api
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/api"]
