# Correlation/AI Engine — Python/FastAPI.
#
# The pip install step uses --trusted-host so the build works on
# corporate networks that do TLS interception (re-signed HTTPS) without
# requiring the corporate CA to be present inside the build container.
# This is a build-time-only relaxation; runtime TLS to external APIs is
# unaffected.

FROM python:3.12-slim@sha256:090ba77e2958f6af52a5341f788b50b032dd4ca28377d2893dcf1ecbdfdfe203 AS build
WORKDIR /app
COPY src/correlation/requirements.txt ./
RUN pip install --no-cache-dir --root-user-action=ignore \
        --trusted-host pypi.org \
        --trusted-host files.pythonhosted.org \
        --trusted-host pypi.python.org \
        -r requirements.txt

FROM python:3.12-slim@sha256:090ba77e2958f6af52a5341f788b50b032dd4ca28377d2893dcf1ecbdfdfe203
WORKDIR /app
COPY --from=build /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=build /usr/local/bin /usr/local/bin
COPY src/correlation/ ./

# Third-party notices for everything installed into site-packages above
# (2026-09-03 licence audit §2.4): certifi is MPL-2.0 — file-level copyleft we
# do not modify, so what we owe is the notice plus a pointer to upstream
# source, and MPL §3.1/§3.2 require the recipient of the image be told. The
# generated notices file carries every Python package's licence and the written
# source offer; NOTICE carries the per-component attributions. certifi's own
# LICENSE also remains in its dist-info under site-packages.
COPY docs/THIRD_PARTY_LICENSES.md NOTICE /app/licenses/
ENV PYTHONUNBUFFERED=1
# SC-008: drop to a non-root system user. The app reads world-readable code and
# binds an unprivileged port (8000), so it needs no root.
RUN useradd --system --uid 10001 appuser
USER appuser
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
