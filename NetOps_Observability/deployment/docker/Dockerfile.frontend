# Frontend image — serves the pre-built React bundle from a small nginx.
#
# We expect `src/frontend/dist/` to exist when this image is built. Build
# it on the host once with:
#
#     cd src/frontend
#     npm install --no-audit --no-fund
#     npm run build
#
# This avoids running `npm install` inside the Docker build, which has
# repeatedly hung on container DNS / registry timeouts on some hosts.
# The dist/ directory is gitignored, so each operator builds it locally.
#
# If you want the previous "all-in-one" build inside Docker, see
# Dockerfile.frontend.full (kept for reference) — but expect slow first
# builds (5–10 min for npm install) and possible hangs.

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# The image's licence, in OCI metadata, so `docker image inspect` answers it
# without unpacking the image. Correlix core is Apache-2.0; see LICENSING.md for
# which parts of the tree are commercial add-ons instead. Enforced by
# scripts/licensing-gate.py check D and tests/test_licensing_consistency.py.
LABEL org.opencontainers.image.licenses="Apache-2.0"

COPY src/frontend/dist /usr/share/nginx/html

# Third-party notices served at /licenses/ (2026-09-03 licence audit §2).
# src/frontend/public/licenses/ — the licence TEXTS for elkjs (EPL-2.0, with the
# §3.2 source pointer), the four OFL-1.1 font families and the Feather/Lucide
# icon path data, plus the rendered index.html — is generated by
# `npm run build`'s prebuild step and arrives inside dist/ above. The canonical
# generated notices file is ALSO copied straight from the repo here, so the
# image ships correct attribution even if it is built against a stale dist/
# (dist/ is gitignored and long-lived; see the REBUILD_FRONTEND note in
# scripts/make-installer.sh for how that has bitten before).
COPY docs/THIRD_PARTY_LICENSES.md /usr/share/nginx/html/licenses/THIRD_PARTY_LICENSES.md

# In-app documentation portal (the "?" Help panel). Like dist/, the Docusaurus
# static site is PRE-BUILT on the host and gitignored, so build it once before
# `docker compose build frontend`:
#
#     cd docs-portal
#     npm install --no-audit --no-fund
#     npm run build            # emits docs-portal/build (baseUrl /docs/)
#
# It's served same-origin at /docs/ (the outer nginx allows same-origin framing
# so the SPA can embed it). Nested under the SPA root so one static container
# serves both; the inner nginx `location /docs/` (frontend/default.conf) serves
# the real files without the SPA history-fallback.
COPY docs-portal/build /usr/share/nginx/html/docs

# The outer nginx (reverse proxy) handles routing; this inner nginx serves
# the SPA with HTML5 history fallback (deep links) and a cache policy that
# keeps redeploys from being masked by a stale cached index.html.
COPY deployment/docker/frontend/default.conf /etc/nginx/conf.d/default.conf

# SC-008: run as the non-root nginx user (uid 101). Built from stock nginx
# (already in our image set — no new external dependency) rather than a separate
# unprivileged image. Move the pid to a writable path, drop the root-only `user`
# directive, and hand the cache/static dirs to uid 101; bind the unprivileged
# :8080 (see frontend/default.conf).
RUN sed -i 's/^user .*/# user directive dropped (runs non-root, SC-008)/; s#pid .*#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf \
    && touch /tmp/nginx.pid \
    && chown -R 101:101 /var/cache/nginx /tmp/nginx.pid /usr/share/nginx/html
USER 101
EXPOSE 8080
