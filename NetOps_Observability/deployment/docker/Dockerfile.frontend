# Frontend image — serves the pre-built React bundle from a small nginx.
#
# We expect `src/frontend/dist/` to exist when this image is built. Build
# it on the host once with:
#
#     cd src/frontend
#     npm install --no-audit --no-fund
#     npm run build
#
# This avoids running `npm install` inside the Docker build, which has
# repeatedly hung on container DNS / registry timeouts on some hosts.
# The dist/ directory is gitignored, so each operator builds it locally.
#
# If you want the previous "all-in-one" build inside Docker, see
# Dockerfile.frontend.full (kept for reference) — but expect slow first
# builds (5–10 min for npm install) and possible hangs.

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

COPY src/frontend/dist /usr/share/nginx/html

# The outer nginx (reverse proxy) handles routing; this inner nginx serves
# the SPA with HTML5 history fallback (deep links) and a cache policy that
# keeps redeploys from being masked by a stale cached index.html.
COPY deployment/docker/frontend/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
