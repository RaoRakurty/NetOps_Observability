# Build the React app, then serve the static bundle from a small nginx.

FROM node:20-alpine AS build
WORKDIR /src
COPY src/frontend/package.json src/frontend/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY src/frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
# The outer nginx (reverse proxy) handles routing; this inner nginx just
# serves the SPA with HTML5 history fallback.
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / { try_files $uri /index.html; }\n}\n' \
  > /etc/nginx/conf.d/default.conf
EXPOSE 80
