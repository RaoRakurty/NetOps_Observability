# Original "all-in-one" frontend Dockerfile — builds npm deps + the
# bundle inside Docker.
#
# Slow first build (5–10 min for npm install) and prone to hanging on
# hosts where TLS interception is in effect (corporate proxies / SSL
# inspection). The `npm config set strict-ssl false` below bypasses
# cert verification at build time so packages still install on those
# networks. Acceptable for fetching public packages; the runtime stack
# is unaffected.
#
# Prefer the lean Dockerfile.frontend (default) which builds the bundle
# on the host and avoids all of this.

FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS build
WORKDIR /src
COPY src/frontend/package.json src/frontend/package-lock.json* ./
RUN npm config set strict-ssl false && \
    npm install --no-audit --no-fund
COPY src/frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
COPY --from=build /src/dist /usr/share/nginx/html
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / { try_files $uri /index.html; }\n}\n' \
  > /etc/nginx/conf.d/default.conf
EXPOSE 80
