# Example HTTPS-terminating nginx config.
#
# To use:
#   1. Place fullchain.pem and privkey.pem under deployment/docker/nginx/certs/.
#      Either:
#        * Run scripts/gen-dev-cert.sh for a self-signed cert (dev only).
#        * Mount real certs from Caddy / certbot / your cert manager.
#   2. In docker-compose.yml under `nginx:`, expose 443 in addition to 80,
#      mount this file as /etc/nginx/conf.d/default.conf (replacing the
#      existing default.conf), and bind-mount the certs dir into the
#      container at /etc/nginx/certs.
#   3. `docker compose up -d nginx`.

upstream api               { server api:8080; }
upstream frontend          { server frontend:80; }
upstream prom              { server prometheus:9090; }
upstream graf              { server grafana:3000; }
upstream osd               { server opensearch-dashboards:5601; }

# Force HTTPS — anything reaching :80 gets redirected.
server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2 default_server;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;
    add_header          Strict-Transport-Security "max-age=63072000" always;
    add_header          X-Content-Type-Options nosniff;
    add_header          X-Frame-Options SAMEORIGIN;
    add_header          Referrer-Policy strict-origin-when-cross-origin;

    client_max_body_size 50m;

    # ----- routes identical to default.conf, with proxy_set_header -----
    location / {
        proxy_pass         http://frontend;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
    location /api/ {
        proxy_pass         http://api;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        # Rate-limit /api/auth/login to slow down credential stuffing.
        limit_req zone=login burst=20 nodelay;
    }
    location /admin/ {
        proxy_pass         http://api;
        proxy_set_header   Host $host;
    }
    location = /metrics {
        proxy_pass         http://api/metrics;
    }
    location /prometheus/ {
        proxy_pass         http://prom/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-Prefix /prometheus;
    }
    location /grafana/ {
        proxy_pass         http://graf;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
    location /search/ {
        proxy_pass         http://osd;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
}

# Rate limit zone — needs to be at the http{} level in nginx.conf for
# the limit_req above to find it. The repo's nginx.conf includes:
#   limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
# Add that line if you're starting from a stock nginx.conf.
