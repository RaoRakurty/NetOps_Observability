# Example HTTPS termination for the single-entry-point nginx.
#
# ── READ THIS FIRST (security) ───────────────────────────────────────────────
# This file is a TLS **FRONT**, not a replacement for default.conf.
#
# default.conf is where the platform's authorization gates live: /metrics,
# /grafana/, /netbox/ and /search/ are each protected by an `auth_request`
# subrequest to the Go API (`/__osd_auth`, `/__osd_auth_search`), which answers
# 200 only for the platform owner. Those gates are load-bearing:
#
#   * Grafana runs with ANONYMOUS Viewer access enabled (so the app's embedded
#     panels render without a second login);
#   * OpenSearch Dashboards runs with its SECURITY PLUGIN DISABLED (no tenant
#     isolation at all);
#   * NetBox runs a privileged superuser and holds the full inventory;
#   * /metrics exposes internal hostnames and per-tenant cardinality.
#
# A TLS server block that proxies those paths WITHOUT the auth_request gates
# publishes all of the above to whoever can reach port 443. An earlier version of
# this example did exactly that — do not reintroduce it.
#
# So this config adds a 443 listener that terminates TLS and forwards every
# request to the ALREADY-GATED server on 127.0.0.1:8080 inside the same nginx
# container. There is no second copy of the route table, therefore no way for the
# gates to drift out of it.
#
# If you would rather terminate TLS in a server block that serves the app
# DIRECTLY (one hop instead of two), you must COPY default.conf's location blocks
# verbatim — including every `auth_request` line, the `error_page 401 403 = @…`
# denial routes, and the internal `/__osd_auth` + `/__osd_auth_search` subrequest
# targets. Copying the proxy_pass lines only is the vulnerability described above.
#
# NOTE: scripts/gen-dev-cert.sh still prints the OLD instruction ("cp
# tls.conf.example → default.conf"). Ignore it — follow the steps below instead;
# copying over default.conf now removes the entire route table (and used to
# remove the auth gates). That script's next-steps text needs updating.
#
# ── To use ───────────────────────────────────────────────────────────────────
#   1. Place fullchain.pem and privkey.pem under deployment/docker/nginx/certs/.
#      Either:
#        * Run scripts/gen-dev-cert.sh for a self-signed cert (dev only).
#        * Mount real certs from Caddy / certbot / your cert manager.
#   2. In docker-compose.yml under `nginx:`, publish 8443 in addition to the
#      existing port, mount this file as /etc/nginx/conf.d/tls.conf — ALONGSIDE
#      default.conf, never replacing it — and bind-mount the certs dir into the
#      container at /etc/nginx/certs, e.g.
#
#        ports:
#          - "443:8443"
#        volumes:
#          - ./nginx/tls.conf.example:/etc/nginx/conf.d/tls.conf:ro
#          - ./nginx/certs:/etc/nginx/certs:ro
#
#      The container runs nginx-unprivileged (SC-008), which cannot bind ports
#      below 1024 — hence 8443 inside, 443 published on the host. Stop publishing
#      the plain-HTTP port once TLS works, so there is nothing to downgrade to.
#   3. Make the key readable by the container's user. nginx runs as uid 101 here,
#      but gen-dev-cert.sh writes privkey.pem 0600 owned by the host user, so
#      nginx fails to start with "cannot load certificate key … Permission
#      denied". Either `chown 101 certs/privkey.pem` (keeping 0600) or run the
#      container with `user: "<your uid>:<gid>"`. Do NOT world-read the key.
#   4. `docker compose up -d nginx`.
#
# Verified with `nginx -t` against this file mounted ALONGSIDE default.conf, and
# a live handshake: HTTP/2 up, HSTS emitted, TLS 1.3 (TLS_AES_256_GCM_SHA384) and
# TLS 1.2 (ECDHE-RSA-AES128-GCM-SHA256, X25519) negotiated, TLS 1.1 refused.
#
# ── Known caveat when combining TLS with the optional profiles ────────────────
# default.conf sets `X-Forwarded-Proto $scheme` on /netbox/, /search/ and /auth/.
# At the inner hop $scheme is "http", so Keycloak (--profile sso) and NetBox
# (--profile netbox) can build http:// issuer/redirect URLs behind this front. If
# you run either profile over TLS, change those three lines in default.conf to
# `proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;` so the value this
# front sets is carried through. Everything else works unmodified.

# WebSocket upgrade passthrough (/api/events, the device SSH gateway). `map` is an
# http{}-level directive and conf.d is included inside http{}, so it belongs here.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8443 ssl;
    http2  on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Modern, PFS-only, AEAD-only. TLS 1.3's suites are fixed by OpenSSL; the
    # list below is the TLS 1.2 set: ECDHE key exchange (forward secrecy) with
    # AES-GCM or ChaCha20-Poly1305 (authenticated encryption). No CBC, no RSA key
    # transport, no SHA-1. TLS 1.0/1.1 are not offered.
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_ecdh_curve            X25519:prime256v1:secp384r1;
    ssl_session_cache         shared:TLS:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off; # tickets without rotation weaken forward secrecy

    # OCSP stapling — enable with a real (non-self-signed) chain:
    # ssl_stapling on;
    # ssl_stapling_verify on;
    # ssl_trusted_certificate /etc/nginx/certs/chain.pem;
    # resolver 127.0.0.11 valid=300s ipv6=off;

    # HSTS belongs at the TLS edge and nowhere else (default.conf deliberately
    # omits it because the default deployment is plain HTTP). Two years, applies
    # to subdomains. Add `preload` only once you are certain every subdomain is
    # HTTPS-only and you intend to submit the domain — it is hard to undo.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    client_max_body_size 50m;

    # Everything goes to the gated server in this same container (default.conf,
    # `listen 8080`). All authorization — auth_request gates, denial pages,
    # security headers, CSP, the SPA/docs/Grafana/NetBox/Dashboards routing — is
    # applied there, exactly once. A literal 127.0.0.1 needs no resolver and
    # cannot go stale, so the dynamic-DNS rule default.conf follows for container
    # upstreams does not apply here.
    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-Port  443;

        # WebSocket passthrough (/api/events, /api/devices/{id}/ssh).
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}

# NOTE: rate limiting is NOT configured here. The previous version of this file
# referenced `limit_req zone=login`, a zone it never defined — nginx refuses to
# start on an unknown zone, so the example could not be used as written. If you
# want per-IP login throttling at the edge, define the zone at http{} level (this
# file is a valid place for it) and apply it in default.conf's /api/ block:
#
#   limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
#   ...
#   location /api/ { limit_req zone=login burst=20 nodelay; ... }
#
# The Go API already enforces per-account lockout on failed sign-ins
# (login_attempts_allowed / unlock_time_seconds in Security Settings), so this is
# defense in depth, not the primary control.
