{
  "_comment": "Apply these on first start with: scripts/bootstrap-opensearch.sh, or call the OS bootstrap API once the cluster is green.",

  "templates": {
    "netops-applogs": {
      "index_patterns": ["netops-applogs-*"],
      "template": {
        "settings": {
          "number_of_shards": 1,
          "number_of_replicas": 0,
          "codec": "best_compression",
          "refresh_interval": "5s"
        },
        "mappings": {
          "properties": {
            "timestamp":      { "type": "date" },
            "level":          { "type": "keyword" },
            "component":      { "type": "keyword" },
            "service":        { "type": "keyword" },
            "container_name": { "type": "keyword" },
            "message":        { "type": "text" },
            "msg":            { "type": "text" },
            "tenant_id":      { "type": "keyword" }
          }
        }
      }
    },

    "netops-syslog": {
      "index_patterns": ["netops-syslog-*"],
      "template": {
        "settings": {
          "number_of_shards": 1,
          "number_of_replicas": 0,
          "codec": "best_compression",
          "refresh_interval": "5s"
        },
        "mappings": {
          "properties": {
            "timestamp": { "type": "date" },
            "hostname":  { "type": "keyword" },
            "appname":   { "type": "keyword" },
            "severity":  { "type": "keyword" },
            "facility":  { "type": "keyword" },
            "message":   { "type": "text" },
            "tenant_id": { "type": "keyword" }
          }
        }
      }
    },

    "netops-flows": {
      "index_patterns": ["netops-flows-*"],
      "template": {
        "settings": {
          "number_of_shards": 1,
          "number_of_replicas": 0,
          "codec": "best_compression",
          "refresh_interval": "10s"
        },
        "mappings": {
          "properties": {
            "timestamp":       { "type": "date" },
            "sampler_address": { "type": "ip" },
            "src_addr":        { "type": "ip" },
            "dst_addr":        { "type": "ip" },
            "src_port":        { "type": "integer" },
            "dst_port":        { "type": "integer" },
            "proto":           { "type": "integer" },
            "bytes":           { "type": "long" },
            "packets":         { "type": "long" },
            "tenant_id":       { "type": "keyword" }
          }
        }
      }
    }
  }
}
