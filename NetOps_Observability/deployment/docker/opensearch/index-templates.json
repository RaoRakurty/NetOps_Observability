    "netops-deadletter": {
      "_comment": "The dead-letter lane is deliberately flat: dropped_at/lane/reason/detail/raw only, raw being an encoded JSON STRING. A dead-letter index that can itself reject a document is worthless, so nothing here is dynamically typed. `detail` carries Vector's own error text (F-14) and `lane` the component that dropped the event; `reason` is the abort/error discriminator.",
      "index_patterns": [
        "netops-deadletter-*"
      ],
      "template": {
        "settings": {
          "number_of_shards": 1,
          "number_of_replicas": "${OPENSEARCH_REPLICAS}",
          "codec": "best_compression",
          "refresh_interval": "5s",
          "mapping": {
            "total_fields": {
              "limit": 1000
            },
            "ignore_malformed": true
          }
        },
        "mappings": {
          "dynamic": false,
          "properties": {
            "dropped_at": {
              "type": "date",
              "format": "strict_date_optional_time||epoch_millis"
            },
            "lane": {
              "type": "keyword"
            },
            "reason": {
              "type": "keyword"
            },
            "detail": {
              "type": "text"
            },
            "raw": {
              "type": "text",
              "index": false
            }
          }
        }
