{
  "_comment": "Apply these on first start with: scripts/bootstrap-opensearch.sh, or call the OS bootstrap API once the cluster is green. Time fields follow docs/design/log-time-standard.md: @timestamp/event_time = source event time normalized to UTC at first parse; ingest_time = Correlix receive time; raw_timestamp = the original timestamp material verbatim; tz_assumed = true when the source zone was assumed rather than carried in the payload. Additive changes here apply to NEWLY created daily indices; existing indices keep their mapping (re-index only if needed).",

  "templates": {
    "netops-applogs": {
      "index_patterns": ["netops-applogs-*"],
      "template": {
        "settings": {
          "number_of_shards": 1,
          "number_of_replicas": 0,
          "refresh_interval": "5s"
        },
        "mappings": {
          "properties": {
            "timestamp":      { "type": "date" },
            "@timestamp":     { "type": "date" },
            "event_time":     { "type": "date" },
            "ingest_time":    { "type": "date" },
            "raw_timestamp":  { "type": "keyword", "ignore_above": 128 },
            "tz_assumed":     { "type": "boolean" },
            "level":          { "type": "keyword" },
            "component":      { "type": "keyword" },
            "service":        { "type": "keyword" },
            "container_name": { "type": "keyword" },
            "message":        { "type": "text" },
            "msg":            { "type": "text" }
          }
        }
      }
    },

    "netops-syslog": {
      "index_patterns": ["netops-syslog-*"],
      "template": {
        "settings": {
          "number_of_shards": 1,
          "number_of_replicas": 0,
          "refresh_interval": "5s"
        },
        "mappings": {
          "properties": {
            "timestamp":     { "type": "date" },
            "@timestamp":    { "type": "date" },
            "event_time":    { "type": "date" },
            "ingest_time":   { "type": "date" },
            "raw_timestamp": { "type": "keyword", "ignore_above": 128 },
            "tz_assumed":    { "type": "boolean" },
            "hostname":      { "type": "keyword" },
            "appname":       { "type": "keyword" },
            "severity":      { "type": "keyword" },
            "facility":      { "type": "keyword" },
            "message":       { "type": "text" }
          }
        }
      }
    },

    "netops-flows": {
      "index_patterns": ["netops-flows-*"],
      "template": {
        "settings": {
          "number_of_shards": 1,
          "number_of_replicas": 0,
          "refresh_interval": "10s"
        },
        "mappings": {
          "properties": {
            "timestamp":       { "type": "date" },
            "@timestamp":      { "type": "date" },
            "event_time":      { "type": "date" },
            "ingest_time":     { "type": "date" },
            "raw_timestamp":   { "type": "keyword", "ignore_above": 128 },
            "tz_assumed":      { "type": "boolean" },
            "sampler_address": { "type": "ip" },
            "src_addr":        { "type": "ip" },
            "dst_addr":        { "type": "ip" },
            "src_port":        { "type": "integer" },
            "dst_port":        { "type": "integer" },
            "proto":           { "type": "integer" },
            "bytes":           { "type": "long" },
            "packets":         { "type": "long" }
          }
        }
      }
    }
  }
}
