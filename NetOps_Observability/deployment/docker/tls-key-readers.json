    {"path": "services/node-exporter/node-exporter.key", "mode": "0600", "how": "dormant", "readers": [], "effective": "not mounted"},
    {"path": "services/opensearch/opensearch.key", "mode": "0640", "how": "group", "readers": ["opensearch"], "effective": "1000:1000"},
    {"path": "services/opensearch-dashboards/opensearch-dashboards.key", "mode": "0600", "how": "dormant", "readers": [], "effective": "not mounted"},
