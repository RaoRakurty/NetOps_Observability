                "locator": {
                  "type": "keyword"
                },
                "kind": {
                  "type": "keyword"
                },
                "ruleset_version": {
                  "type": "keyword"
                },
                "digest": {
                  "type": "keyword"
                }
              }
            },
            "attrs": {
              "properties": {
                "evidence_class": {
                  "type": "keyword"
                },
                "provider_source": {
                  "type": "keyword"
                },
                "control_id": {
                  "type": "keyword"
                },
                "control_title": {
                  "type": "keyword"
                },
                "category": {
                  "type": "keyword"
                },
                "raw_rule_id": {
                  "type": "keyword"
                },
                "scan_id": {
                  "type": "keyword"
                },
                "status": {
                  "type": "keyword"
                },
                "status_id": {
                  "type": "keyword"
                },
                "standards": {
                  "type": "keyword"
                },
                "status_detail": {
                  "type": "keyword",
                  "ignore_above": 1024,
                  "fields": {
                    "text": {
                      "type": "text"
                    }
                  }
                }
              }
            },
            "lane": {
              "type": "keyword"
            },
            "reason": {
              "type": "keyword"
            }
          }
        }
      }
    },
    "netops-deadletter": {
      "_comment": "The dead-letter lane is deliberately flat: dropped_at/lane/reason/detail/raw only, raw being an encoded JSON STRING. A dead-letter index that can itself reject a document is worthless, so nothing here is dynamically typed. `detail` carries Vector's own error text (F-14) and `lane` the component that dropped the event; `reason` is the abort/error discriminator.",
      "index_patterns": [
        "netops-deadletter-*"
      ],
      "template": {
        "settings": {
          "number_of_shards": 1,
          "number_of_replicas": "${OPENSEARCH_REPLICAS}",
          "codec": "best_compression",
          "refresh_interval": "5s",
          "mapping": {
            "total_fields": {
              "limit": 1000
            },
            "ignore_malformed": true
          }
        },
        "mappings": {
          "dynamic": false,
          "properties": {
            "dropped_at": {
              "type": "date",
              "format": "strict_date_optional_time||epoch_millis"
            },
            "lane": {
              "type": "keyword"
            },
            "reason": {
              "type": "keyword"
            },
            "detail": {
              "type": "text"
            },
            "raw": {
              "type": "text",
              "index": false
            }
          }
        }
      }
    },
    "netops-quarantine": {
      "_comment": "F-11 seal-or-quarantine: TENANT_UNATTRIBUTABLE envelopes. Metadata only is mapped; cx_quarantine_payload (the <enc:v1:quarantine:...> token over the whole original event) is DELIBERATELY UNMAPPED \u2014 dynamic:false keeps it in _source for the operator workflow while never making ciphertext searchable/aggregatable surface. cx_restored_at is the flows replay-guard claim stamp (quarantine.RestoredAtField): set by the restore API before a flows produce, and a stamped envelope is only ever tombstoned, never re-produced (the ClickHouse canonical flow store has no id dedup) \u2014 mapped as a date so operators can find lingering claimed envelopes. No tenant segment: no tenant read path names this index; the platform-only quarantine API is the sole consumer. Retention is its own ISM policy (QUARANTINE_RETENTION_DAYS), never unbounded (INV-F11-09).",
      "index_patterns": [
        "netops-quarantine-*"
      ],
      "template": {
        "settings": {
          "number_of_shards": 1,
          "number_of_replicas": "${OPENSEARCH_REPLICAS}",
          "codec": "best_compression",
          "refresh_interval": "5s",
          "mapping": {
            "total_fields": {
              "limit": 1000
            },
            "ignore_malformed": true
          }
        },
        "mappings": {
          "dynamic": false,
          "properties": {
            "cx_quarantine": {
              "type": "boolean"
            },
            "cx_event_id": {
              "type": "keyword"
            },
            "received_at": {
              "type": "date",
              "format": "strict_date_optional_time||epoch_millis"
            },
            "lane": {
              "type": "keyword"
            },
            "identity_sha": {
              "type": "keyword"
            },
            "source_ip": {
              "type": "keyword"
            },
            "reason": {
              "type": "keyword"
            },
            "cx_restored_at": {
              "type": "date",
              "format": "strict_date_optional_time||epoch_millis"
            }
          }
        }
      }
    }
  }
}
