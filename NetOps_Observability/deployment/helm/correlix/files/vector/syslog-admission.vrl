# syslog-admission.vrl — GENERATED by scripts/gen-syslog-admission.py.
# DO NOT EDIT BY HAND: re-run the generator, or CI's drift test fails.
#
# Compiled from src/correlation/producers.py — the same screen the
# correlation engine applies in-process (`syslog_promotable`). Sets
# `.cx_admission = {"v": <rules_hash prefix>, "by": <gate>}` on a line
# the engine COULD promote, and leaves the field unset otherwise. It
# never drops, rewrites or reorders anything: the stamp is additive.
#
#   rules_hash : d9d433dbaa11f8440a46f20dd9a4c9a8dacb4b400dfa788f80536974e566f71a
#   v          : d9d433dbaa11
#   floor      : ALARM_SEVERITY_FLOOR = 4
#   screen     : 72 literals
#
# Field parity: this runs immediately after `syslog_normalized`, so it
# reads exactly the document `kafka_syslog` serializes onto
# netops.syslog — the same dict `syslog_promotable` receives.

# ── severity (producers.syslog_severity_num) ────────────────────────
# `99` is the no-severity sentinel: Python's `min([]) -> None`,
# which never satisfies the floor. Keyword AND tag digit are both read;
# the MOST severe (numerically smallest) of the two wins.
cx_sev = 99
cx_kw = downcase(strip_whitespace(string(.severity) ?? ""))
if includes(["emerg", "emergency"], cx_kw) {
  cx_sev = 0
} else if includes(["alert"], cx_kw) {
  cx_sev = 1
} else if includes(["c", "crit", "critical"], cx_kw) {
  cx_sev = 2
} else if includes(["e", "err", "error"], cx_kw) {
  cx_sev = 3
} else if includes(["w", "warn", "warning"], cx_kw) {
  cx_sev = 4
} else if includes(["n", "note", "notice"], cx_kw) {
  cx_sev = 5
} else if includes(["i", "info", "informational"], cx_kw) {
  cx_sev = 6
} else if includes(["d", "debug"], cx_kw) {
  cx_sev = 7
}

cx_tag = upcase(string(.appname) ?? "")
cx_tag_sev = 99
cx_m = parse_regex(cx_tag, r'%[A-Z0-9_]+-(?P<d>\d)-[A-Z0-9_]+') ?? {}
if is_string(cx_m.d) {
  cx_tag_sev = to_int(cx_m.d) ?? 99
}
if cx_tag_sev < cx_sev {
  cx_sev = cx_tag_sev
}

# ── vendor-pack severity (producers.syslog_alarm_num) ───────────────
# The grammars are telemetry-catalog/vendor-packs/*.yaml. A matching row
# adds the severity the line's own text states, and its alarm floor then
# decides whether severity alone may admit the line (owner D3).
cx_pk_msg = string(.message) ?? ""
cx_pk_app = downcase(string(.appname) ?? "")
cx_pk_inv = ""
if (string(.vendor_source) ?? "") == "inventory" {
  cx_pk_inv = string(.vendor) ?? ""
}
cx_pk_open = true
cx_pk_n = 99
cx_pk_floor = 99
if cx_pk_open && (cx_pk_inv == "" || cx_pk_inv == "cisco") && contains(cx_pk_msg, "%Viptela-") {
  cx_pk_m, cx_pk_err = parse_regex(cx_pk_msg, r'%Viptela-(?P<origin>\S{1,64}?)-(?P<proc>[A-Za-z][A-Za-z0-9_]{0,31})-(?P<sev>[0-7])-(?P<word>[A-Z]{4})-(?P<id>\d{1,12}):\s*(?P<text>Notification:.{0,48}?\b(?P<name>[a-z]+(?:-[a-z]+)+)\b\s*(?:severity-level:(?P<level>[a-z]+))?.*)')
  if cx_pk_err == null {
    cx_pk_v = 99
    cx_pk_v = to_int(cx_pk_m.sev) ?? 99
    if cx_pk_v < 99 {
      cx_pk_open = false
      cx_pk_n = cx_pk_v
      cx_pk_floor = 2
    }
  }
}
if cx_pk_open && (cx_pk_inv == "" || cx_pk_inv == "cisco") && contains(cx_pk_msg, "%Viptela-") {
  cx_pk_m, cx_pk_err = parse_regex(cx_pk_msg, r'%Viptela-(?P<origin>\S{1,64}?)-(?P<proc>[A-Za-z][A-Za-z0-9_]{0,31})-(?P<sev>[0-7])-(?P<word>[A-Z]{4})-(?P<id>\d{1,12}):\s*(?P<text>.*)')
  if cx_pk_err == null {
    cx_pk_v = 99
    cx_pk_v = to_int(cx_pk_m.sev) ?? 99
    if cx_pk_v < 99 {
      cx_pk_open = false
      cx_pk_n = cx_pk_v
      cx_pk_floor = 2
    }
  }
}
if cx_pk_open && (cx_pk_inv == "" || cx_pk_inv == "cisco") && contains(cx_pk_msg, "%Cisco-SDWAN-") {
  cx_pk_m, cx_pk_err = parse_regex(cx_pk_msg, r'%Cisco-SDWAN-(?P<origin>\S{1,64}?)-(?P<proc>[A-Za-z][A-Za-z0-9_]{0,31})-(?P<sev>[0-7])-(?P<word>[A-Z]{4})-(?P<id>\d{1,12}):\s*(?P<text>.*)')
  if cx_pk_err == null {
    cx_pk_v = 99
    cx_pk_v = to_int(cx_pk_m.sev) ?? 99
    if cx_pk_v < 99 {
      cx_pk_open = false
      cx_pk_n = cx_pk_v
      cx_pk_floor = 2
    }
  }
}
if cx_pk_n < cx_sev {
  cx_sev = cx_pk_n
}
if !cx_pk_open && cx_sev > cx_pk_floor {
  cx_sev = 99
}

# ── gate 1: the device called it warning-or-worse ───────────────────
if cx_sev <= 4 {
  .cx_admission = { "v": "d9d433dbaa11", "by": "severity" }
}

# ── gate 2: a known typed symptom marker, at any severity ───────────
# The haystack is `message + " " + upcase(appname) + " " + facility +
# " " + event_type`, lower-cased — byte-for-byte the join
# `syslog_promotable` builds. The alternation below is the screen's
# 72 literals (longest first, as in the Python tuple); Rust's
# regex compiles an alternation of plain literals into a literal-set
# matcher, so this is one pass, not 61 substring searches.
if !exists(.cx_admission) {
  cx_hay = downcase(
    (string(.message) ?? "") + " " + cx_tag + " " +
    (string(.facility) ?? "") + " " + (string(.event_type) ?? ""))
  if match(cx_hay, r'system cpu usage back to normal level|-ftmd-3-erro-1000003: user ifname = |control-connection-state-change|: system cpu usage is above |: system cpu usage is below |unsupported_transceiver|resolution successful|is flapping between|isisadjacencychange|has moved between|bfd-state-change|lookup succeeded|between nve and|duplicate host|vxlan_mac_move|%cisco-sdwan-|corrected_fec|uncorrectable|notification|prefix-limit|remote_fault|rx_power_low| failed for|blacklisted|local_fault|signal_loss|temperature|transceiver|unqualified|unsupported|remotepeer|%viptela-|adjchange|bias_high|corrected|nbr_reset|qualified|temp_high|threshold|dup_host|mac_move|spantree|macflap|standby|warning|adjchg|deskew|maxpfx|remote|signal|updown|alarm|align|error|light|local|optic|power|clns|evpn|flap|hsrp|lldp|move|post|vrrp|vtep|ber|hmm|los|nve|pre') {
    .cx_admission = { "v": "d9d433dbaa11", "by": "marker" }
  }
}

