# Config for stack-watchdog.sh. Copy to stack-watchdog.env and fill in.
# stack-watchdog.env is gitignored — it holds your private topic/URL.

# ntfy.sh topic to push phone alerts to. Treat it like a password: anyone
# who knows the topic can read your alerts. Subscribe to it in the ntfy app.
NTFY_TOPIC=

# Self-hosted ntfy server? Override here. Default is the public service.
#NTFY_SERVER=https://ntfy.sh

# healthchecks.io ping URL (the dead-man's-switch heartbeat). Leave blank to
# disable. Create a check at https://healthchecks.io, set period 1m / grace
# ~2-3m, point its integration at ntfy, and paste the ping URL here.
HC_PING_URL=

# Disk watermark — warn before OpenSearch's 95% flood stage (which silently
# turns every index read-only and stops log ingestion). At DISK_PRUNE_PCT the
# watchdog auto-prunes reclaimable Docker build cache before alerting.
#DISK_WARN_PCT=85
#DISK_PRUNE_PCT=90

# Ingestion liveness — alert if zero container-logs (applogs) landed in the last
# N minutes (a silent log-bus stall: disk block, dead Vector/Kafka consumer).
#INGEST_STALE_MIN=15

# Backup freshness (F-59) — alert if the newest OpenSearch snapshot in the
# netops-fs repository is older than N hours, or if the repository is missing /
# empty / PARTIAL. Checked HERE rather than in rules.yaml on purpose: an alarm
# about the last line of defence must not share fate with the stack it guards.
# 0 disables the check (only correct if you back the volumes up another way).
#SNAPSHOT_MAX_AGE_H=36

# Overrides (defaults shown):
#COMPOSE_PROJECT=netops
#APP_URL=http://localhost:8000/
