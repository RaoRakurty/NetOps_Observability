# Config for stack-watchdog.sh. Two supported locations:
#   * stack-watchdog.env next to the script — copy this file there (gitignored;
#     it holds your private topic/URLs/tokens).
#   * /etc/correlix/stack-watchdog.env — written by install-watchdog.sh on
#     packaged installs (root:root 0600). The sibling file wins if both exist;
#     WATCHDOG_ENV overrides both.

# --- Notification channels (configure at least one) ---------------------------

# ntfy topic to push phone alerts to. Subscribe to it in the ntfy app.
# SECURITY POSTURE: on the public https://ntfy.sh server the topic NAME is the
# only secret — anyone who learns or guesses it can read AND publish your
# alerts. That is obscurity, not access control. Minimum bar: a high-entropy
# topic (e.g. `openssl rand -hex 16`). Enterprise bar: a self-hosted ntfy
# server with authentication (NTFY_SERVER + NTFY_TOKEN below), or the webhook /
# healthchecks channels instead.
NTFY_TOPIC=

# Self-hosted ntfy server? Override here. Default is the public service.
#NTFY_SERVER=https://ntfy.sh

# Access token for an authenticated (self-hosted) ntfy server; sent as
# `Authorization: Bearer <token>` on every publish. Leave empty for ntfy.sh.
#NTFY_TOKEN=

# Also deliver each alert to this address via ntfy's per-message `Email:`
# header. REQUIRES NTFY_TOPIC — ntfy can only publish to a topic, and the
# email rides that publish (the watchdog refuses email-without-topic loudly).
# Note ntfy.sh rate-limits email fan-out; a self-hosted server needs SMTP
# configured. For a zero-secret enterprise email path prefer HC_PING_URL:
# healthchecks.io pings carry NO alert content (pure dead-man's switch), and
# its own notification channels (email/SMS/PagerDuty/...) do the delivery.
#WATCHDOG_EMAIL=

# healthchecks.io ping URL (the dead-man's-switch heartbeat). Leave blank to
# disable. Create a check at https://healthchecks.io, set period 1m / grace
# ~2-3m, attach the notification channels you want (email, SMS, PagerDuty,
# ntfy, ...), and paste the ping URL here. Pings carry no alert content, so
# nothing sensitive transits this channel.
HC_PING_URL=

# Generic enterprise webhook: on every up<->down transition the watchdog POSTs
#   {"host":"...","status":"down|up","detail":"...","ts":"..."}
# to this https URL — Slack/Teams/Opsgenie incoming webhooks, PagerDuty via a
# relay, or your own receiver. Optional bearer token sent as
# `Authorization: Bearer <token>`.
#WATCHDOG_WEBHOOK_URL=
#WATCHDOG_WEBHOOK_TOKEN=

# --- Probe tuning -------------------------------------------------------------

# Disk watermark — warn before OpenSearch's 95% flood stage (which silently
# turns every index read-only and stops log ingestion). At DISK_PRUNE_PCT the
# watchdog auto-prunes reclaimable Docker build cache before alerting.
#DISK_WARN_PCT=85
#DISK_PRUNE_PCT=90

# Ingestion liveness — alert if zero container-logs (applogs) landed in the last
# N minutes (a silent log-bus stall: disk block, dead Vector/Kafka consumer).
#INGEST_STALE_MIN=15

# Backup freshness (F-59) — alert if the newest OpenSearch snapshot in the
# netops-fs repository is older than N hours, or if the repository is missing /
# empty / PARTIAL. Checked HERE rather than in rules.yaml on purpose: an alarm
# about the last line of defence must not share fate with the stack it guards.
# 0 disables the check (only correct if you back the volumes up another way).
#SNAPSHOT_MAX_AGE_H=36

# Snapshot RESTORABILITY (2026-09-03) — freshness is not restorability, and the
# difference cost seven days. A manual `rm -rf data/opensearch-snapshots/indices`
# during a disk crunch deleted the repository's blob tree while the repository
# stayed registered: OpenSearch re-created the empty directory at the next
# scheduled snapshot, every shard failed with NoSuchFileException, and the check
# above kept reading a perfectly fresh newest-snapshot timestamp the whole time.
# Nothing had ever attempted a RESTORE.
#
# This reads the api's restore-probe verdict
# (netops_opensearch_snapshot_restorable) out of VictoriaMetrics, over the same
# seam as the consumer-group and alert-delivery probes, and treats an ABSENT
# series as UNPROVEN rather than healthy. 0 disables it — which means nothing on
# this host is proving that a restore is possible.
#SNAPSHOT_RESTORABLE_CHECK=1

# Engine-liveness probes (consumer-group membership + the alert-delivery
# heartbeat). 0 disables all three; see the block in stack-watchdog.sh for what
# each one asks and why they live in the external watchdog.
#ENGINE_CONSUMER_CHECK=1

# Stuck DEBUG log levels (pipeline debugger, docs/runbooks/pipeline-debug.md §6).
# `correlix-debug logs` raises a module to debug for a BOUNDED window and three
# reverts are supposed to bring it back down — all three of them inside the
# stack. This is the fourth and the only external one, so it still works when
# the api is the thing that is wedged, which is the case where the module's own
# in-process timer did not fire. A module left at debug fills the disk, costs
# ingest throughput and writes tenant payloads into logs that ship in support
# bundles. 0 disables the check; the grace is the slack allowed past the armed
# revert time (scrape interval + timer scheduling + this cron's one-minute
# granularity all have to fit inside it).
#DEBUG_LEVEL_CHECK=1
#DEBUG_LEVEL_STUCK_GRACE_SEC=300

# Compose services the watchdog requires running (and healthy, where a
# healthcheck exists), space-separated. Unset = the built-in default list.
# Packaged installs get the customer base set written by install-watchdog.sh;
# extend it when you enable add-ons (e.g. append: opensearch-dashboards
# grafana cadvisor node-exporter kafka-exporter).
#WATCHDOG_SERVICES=

# Backup-intent applier (#150) — the watchdog runs apply-backup-config.sh
# whenever the GUI's stored intent file is newer than the last-applied stamp,
# closing the Settings → Data Protection loop host-side. Defaults assume the
# repo layout (watchdog living in scripts/ next to the applier, intent under
# ../data/api). A packaged install (watchdog copied to /etc/correlix) MUST set
# all three to the extracted bundle's paths, or stored backup settings are
# never enforced — the watchdog then reports exactly that as a problem.
# install-watchdog.sh WRITES all three (derived from the bundle it was pointed
# at) into /etc/correlix/stack-watchdog.env, so packaged installs get them for
# free; set them here only for a non-standard layout.
#BACKUP_INTENT_FILE=/opt/correlix/data/api/system_backup.json
#BACKUP_APPLY_SCRIPT=/opt/correlix/scripts/apply-backup-config.sh
#BACKUP_APPLY_STAMP=/etc/correlix/.backup-config.applied

# Stack .env the store probes read credentials + the TLS-variant marker from
# (CLICKHOUSE_USER/PASSWORD, OS_API_PASSWORD, OS_AGGREGATOR_PASSWORD,
# COMPOSE_FILE). Default: ../deployment/docker/.env relative to the script —
# correct for the repo layout, WRONG for the packaged /etc/correlix copy, so
# install-watchdog.sh writes the bundle's real path. The ClickHouse probe URL
# is auto-detected from COMPOSE_FILE (https://clickhouse:8443 on the TLS
# variant, http://clickhouse:8123 otherwise); CH_PROBE_URL overrides.
#CH_ENV_FILE=/opt/correlix/deployment/docker/.env
#CH_PROBE_URL=

# Overrides (defaults shown; install-watchdog.sh writes COMPOSE_PROJECT=netops
# explicitly so a root cron's environment can never redirect the probes):
#COMPOSE_PROJECT=netops
#APP_URL=http://localhost:8000/
# PEM CA cert for an https APP_URL behind a self-signed ingress — the probe
# then VALIDATES the cert instead of skipping verification. Empty = system
# trust store (publicly-issued certs need nothing here).
#APP_CACERT=
