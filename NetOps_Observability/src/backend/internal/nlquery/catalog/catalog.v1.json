{
 "schema_version": 1,
 "entities": [
  {
   "name": "site",
   "description": "A customer site, branch or location",
   "id_prefix": "site:",
   "id_pattern": "^site:[a-z0-9][a-z0-9-]{0,63}$",
   "name_fields": [
    "name",
    "slug"
   ],
   "aliases": [
    "branch",
    "location",
    "office",
    "campus",
    "sites"
   ],
   "resolver": "site_store",
   "sensitivity": "operational"
  },
  {
   "name": "device",
   "description": "A network device (router, switch, firewall, SD-WAN edge)",
   "id_prefix": "device:",
   "id_pattern": "^device:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
   "name_fields": [
    "name",
    "id"
   ],
   "aliases": [
    "router",
    "switch",
    "firewall",
    "edge",
    "box",
    "node",
    "devices",
    "routers",
    "switches"
   ],
   "resolver": "discovery",
   "sensitivity": "operational",
   "metric_labels": [
    {
     "label": "device",
     "from": "device_id|device_name"
    }
   ]
  },
  {
   "name": "interface",
   "description": "An interface (port) on a device",
   "id_prefix": "interface:",
   "id_pattern": "^interface:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/[A-Za-z0-9._:/-]{1,64}$",
   "name_fields": [
    "ifName",
    "ifAlias"
   ],
   "aliases": [
    "port",
    "ports",
    "interfaces",
    "link",
    "links",
    "intf"
   ],
   "resolver": "label_pair",
   "sensitivity": "operational",
   "metric_labels": [
    {
     "label": "device",
     "from": "device_id|device_name"
    },
    {
     "label": "ifName",
     "from": "interface_name"
    }
   ]
  },
  {
   "name": "circuit",
   "description": "A WAN circuit (underlay link to a provider)",
   "id_prefix": "circuit:",
   "id_pattern": "^circuit:[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
   "name_fields": [
    "local_device",
    "local_if"
   ],
   "aliases": [
    "circuits",
    "wan circuit",
    "wan link",
    "wan links",
    "underlay"
   ],
   "resolver": "wan_projection",
   "sensitivity": "operational",
   "metric_labels": [
    {
     "label": "circuit",
     "from": "circuit_id"
    },
    {
     "label": "local_device",
     "from": "device_name"
    }
   ]
  },
  {
   "name": "bgp_peer",
   "description": "A BGP session between a device and a neighbour",
   "id_prefix": "bgp_peer:",
   "id_pattern": "^bgp_peer:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/[0-9A-Fa-f.:]{2,45}(@[A-Za-z0-9._-]{1,32})?$",
   "name_fields": [
    "peer"
   ],
   "aliases": [
    "bgp peer",
    "bgp peers",
    "neighbor",
    "neighbour",
    "neighbors",
    "neighbours",
    "bgp session",
    "bgp sessions"
   ],
   "resolver": "label_pair",
   "sensitivity": "operational",
   "metric_labels": [
    {
     "label": "device",
     "from": "device_id|device_name"
    },
    {
     "label": "peer",
     "from": "peer_ip"
    }
   ]
  },
  {
   "name": "provider",
   "description": "A network service provider or carrier",
   "id_prefix": "provider:",
   "id_pattern": "^provider:[a-z0-9][a-z0-9-]{0,63}$",
   "name_fields": [
    "name"
   ],
   "aliases": [
    "isp",
    "carrier",
    "providers",
    "isps",
    "carriers"
   ],
   "resolver": "alias_table",
   "sensitivity": "operational"
  },
  {
   "name": "application",
   "description": "A business application or SaaS service",
   "id_prefix": "app:",
   "id_pattern": "^app:[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
   "name_fields": [
    "name"
   ],
   "aliases": [
    "app",
    "apps",
    "applications",
    "saas",
    "service",
    "services"
   ],
   "resolver": "alias_table",
   "sensitivity": "operational"
  },
  {
   "name": "incident",
   "description": "A Correlix incident (correlation case)",
   "id_prefix": "incident:",
   "id_pattern": "^incident:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
   "name_fields": [
    "display_id",
    "title"
   ],
   "aliases": [
    "incidents",
    "outage",
    "outages",
    "problem",
    "problems",
    "issue",
    "issues",
    "case"
   ],
   "resolver": "corr_current",
   "sensitivity": "operational"
  },
  {
   "name": "change",
   "description": "A recorded operational change",
   "id_prefix": "change:",
   "id_pattern": "^change:[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
   "name_fields": [
    "summary"
   ],
   "aliases": [
    "changes",
    "modification",
    "modifications"
   ],
   "resolver": "change_ledger",
   "sensitivity": "operational"
  },
  {
   "name": "probe_target",
   "description": "A synthetic probe target",
   "id_prefix": "probe:",
   "id_pattern": "^probe:[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
   "name_fields": [
    "dst"
   ],
   "aliases": [
    "probe target",
    "probe targets",
    "synthetic target"
   ],
   "resolver": "label_pair",
   "sensitivity": "operational",
   "metric_labels": [
    {
     "label": "dst",
     "from": "target"
    }
   ]
  }
 ],
 "metrics": [
  {
   "name": "if_in_bps",
   "description": "Inbound traffic rate on an interface",
   "unit": "bps",
   "aliases": [
    "inbound traffic",
    "input traffic",
    "ingress traffic",
    "rx rate"
   ],
   "entity_types": [
    "interface"
   ],
   "backend": "victoriametrics",
   "physical_metrics": [
    "device_if_in_octets"
   ],
   "labels": {
    "device": "device",
    "interface": "ifName"
   },
   "aggregations": [
    "avg",
    "max",
    "p95"
   ],
   "default_agg": "avg",
   "operators": [
    "gt",
    "ge",
    "lt",
    "le",
    "between",
    "above_baseline",
    "increased_by"
   ],
   "baseline_ok": true,
   "fanout_hint": 2,
   "scope": "device_scoped",
   "emitters": [
    {
     "file": "src/backend/collectors/profiles.go",
     "contains": "\"device_if_in_octets\""
    },
    {
     "file": "deployment/docker/gnmic/gnmic.yaml",
     "contains": "device_if_in_octets"
    }
   ],
   "quality": [
    "64-bit counters; gNMI owns the series when a device streams it"
   ]
  },
  {
   "name": "if_out_bps",
   "description": "Outbound traffic rate on an interface",
