{
  "schema": "correlix.nlquery.golden/v1",
  "category": "aggregation",
  "cases": [
    {
      "id": "aggregation-001",
      "category": "aggregation",
      "question": "Show average CPU across Dallas devices for the last 6 hours.",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "show_metric",
        "entities": [
          {
            "input": "Dallas",
            "type": "site",
            "id": "site:dfw-hq",
            "method": "site_store"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "metric_series",
          "target": "device",
          "metric": "cpu_util_pct",
          "aggregation": "avg",
          "entities": [
            {
              "type": "site",
              "id": "site:dfw-hq"
            }
          ],
          "time_range": {
            "kind": "relative",
            "last": "6h"
          },
          "group_by": [
            "site"
          ]
        },
        "alternates": [],
        "result_semantics": {
          "kind": "timeseries",
          "must_include_refs": []
        }
      },
      "paraphrases": [
        "avg cpu across dfw last 6h",
        "mean cpu over all dallas boxes past six hours",
        "dallas average cpu last 6 hrs"
      ]
    },
