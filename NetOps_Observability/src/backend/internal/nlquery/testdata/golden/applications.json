    {
      "id": "applications-001",
      "category": "applications",
      "question": "Why is Salesforce slow in Dallas?",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "list_incidents",
        "entities": [
          {
            "input": "Salesforce",
            "type": "application",
            "id": "app:salesforce",
            "method": "alias_table"
          },
          {
            "input": "Dallas",
            "type": "site",
            "id": "site:dfw-hq",
            "method": "site_store"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "incident_list",
          "target": "incident",
          "entities": [
            {
              "type": "application",
              "id": "app:salesforce"
            },
            {
              "type": "site",
              "id": "site:dfw-hq"
            }
          ],
          "time_range": {},
          "order_by": [
            {
              "field": "created_at",
              "dir": "desc"
            }
          ]
        },
        "alternates": [],
        "result_semantics": {
          "kind": "incident_rows",
          "must_include_refs": [
            "incident:3f2a9c1e-7b4d-4e8a-9c01-5d6e7f8a9b0c"
          ],
          "min_rows": 1
        }
      },
      "paraphrases": [
        "salesforce slow at dfw - why?",
        "what's wrong with salesforce in dallas",
        "why's SFDC sluggish in Dallas"
      ]
    },
