    {
      "id": "applications-005",
      "category": "applications",
      "question": "Show latency to login.salesforce.com for the last hour.",
      "context": {
        "tz": "America/Chicago",
        "cross": true
      },
      "expect": {
        "intent": "show_metric",
        "entities": [
          {
            "input": "login.salesforce.com",
            "type": "probe_target",
            "id": "probe:login.salesforce.com",
            "method": "label_pair"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "metric_series",
          "target": "probe_target",
          "metric": "probe_rtt_ms",
          "aggregation": "p95",
          "entities": [
            {
              "type": "probe_target",
              "id": "probe:login.salesforce.com"
            }
          ],
          "time_range": {
            "kind": "relative",
