{
  "schema": "correlix.nlquery.golden/v1",
  "category": "circuits",
  "cases": [
    {
      "id": "circuits-001",
      "category": "circuits",
      "question": "Show latency on the Dallas Comcast circuit for the last 2 hours.",
      "context": {
        "tz": "America/Chicago",
        "cross": true
      },
      "expect": {
        "intent": "show_metric",
        "entities": [
          {
            "input": "the Dallas Comcast circuit",
            "type": "circuit",
            "id": "circuit:dfw-comcast-1",
            "method": "wan_projection"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "metric_series",
          "target": "circuit",
          "metric": "circuit_latency_ms",
          "aggregation": "p95",
          "entities": [
            {
              "type": "circuit",
              "id": "circuit:dfw-comcast-1"
            }
          ],
          "time_range": {
            "kind": "relative",
            "last": "2h"
          }
        },
        "alternates": [],
        "result_semantics": {
          "kind": "timeseries",
          "must_include_refs": [
            "circuit:dfw-comcast-1"
          ]
        }
      },
      "paraphrases": [
        "dfw comcast circuit latency last 2h",
        "rtt on the Dallas Comcast link past two hours",
        "latency dfw-comcast-1 last 2 hrs"
      ]
    },
