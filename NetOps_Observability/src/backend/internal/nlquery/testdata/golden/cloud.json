{
  "schema": "correlix.nlquery.golden/v1",
  "category": "cloud",
  "cases": [
    {
      "id": "cloud-001",
      "category": "cloud",
      "question": "Show cloud changes in the last 7 days.",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "list_changes",
        "entities": [],
        "ast": {
          "v": 1,
          "query_type": "change_list",
          "target": "change",
          "filters": [
            {
              "field": "type",
              "op": "eq",
              "values": [
                "CLOUD_CHANGE"
              ]
            }
          ],
          "time_range": {
            "kind": "relative",
            "last": "7d"
          },
          "order_by": [
            {
              "field": "event_at",
              "dir": "desc"
            }
          ]
        },
        "alternates": [],
        "result_semantics": {
          "kind": "change_rows",
          "must_include_refs": [
            "change:chg-1048"
          ],
          "min_rows": 1
        }
      },
      "paraphrases": [
        "cloud changes past week",
        "any cloud changes last 7 days",
        "what changed in the cloud this past week"
      ]
    },
