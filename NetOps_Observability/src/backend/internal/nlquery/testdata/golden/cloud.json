    {
      "id": "cloud-003",
      "category": "cloud",
      "question": "Show latency on the AWS Direct Connect for the last 6 hours.",
      "context": {
        "tz": "America/Chicago",
        "cross": true
      },
      "expect": {
        "intent": "show_metric",
        "entities": [
          {
            "input": "the AWS Direct Connect",
            "type": "circuit",
            "id": "circuit:nyc-aws-dx-1",
            "method": "wan_projection"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "metric_series",
          "target": "circuit",
          "metric": "circuit_latency_ms",
          "aggregation": "p95",
          "entities": [
            {
              "type": "circuit",
              "id": "circuit:nyc-aws-dx-1"
            }
          ],
          "time_range": {
            "kind": "relative",
            "last": "6h"
          }
        },
        "alternates": [],
        "result_semantics": {
          "kind": "timeseries",
          "must_include_refs": [
            "circuit:nyc-aws-dx-1"
          ]
        }
      },
      "paraphrases": [
        "aws dx latency last 6h",
        "direct connect rtt past six hours",
        "latency nyc-aws-dx-1 last 6 hrs"
      ]
    },
