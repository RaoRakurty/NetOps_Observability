    {
      "id": "configuration-001",
      "category": "configuration",
      "question": "Show config changes on dfw-core-1 today.",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "list_changes",
        "entities": [
          {
            "input": "dfw-core-1",
            "type": "device",
            "id": "device:dfw-core-1",
            "method": "discovery"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "change_list",
          "target": "change",
          "entities": [
            {
              "type": "device",
              "id": "device:dfw-core-1"
            }
          ],
          "filters": [
            {
              "field": "type",
              "op": "eq",
              "values": [
                "CONFIG_CHANGE"
              ]
            }
          ],
          "time_range": {
            "kind": "absolute",
            "from": "2026-09-24T05:00:00Z",
            "to": "2026-09-24T15:00:00Z"
          },
          "order_by": [
            {
              "field": "event_at",
              "dir": "desc"
            }
          ]
        },
        "alternates": [],
        "result_semantics": {
          "kind": "change_rows",
          "must_include_refs": [
            "change:chg-1043"
          ],
          "min_rows": 1
        }
      },
      "paraphrases": [
        "dfw-core-1 config changes today",
        "configuration edits on DFW-CORE-1 since midnight",
        "what config changed on dfw core today"
      ]
    },
