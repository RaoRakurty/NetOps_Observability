{
  "schema": "correlix.nlquery.golden/v1",
  "category": "devices",
  "cases": [
    {
      "id": "devices-001",
      "category": "devices",
      "question": "Show CPU on every device at Austin for the last 3 hours.",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "show_metric",
        "entities": [
          {
            "input": "Austin",
            "type": "site",
            "id": "site:aus-br",
            "method": "site_store"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "metric_series",
          "target": "device",
          "metric": "cpu_util_pct",
          "aggregation": "avg",
          "entities": [
            {
              "type": "site",
              "id": "site:aus-br"
            }
          ],
          "time_range": {
            "kind": "relative",
            "last": "3h"
          }
        },
        "alternates": [],
        "result_semantics": {
          "kind": "timeseries",
          "must_include_refs": [
            "device:aus-edge-1",
            "device:aus-sw-1"
          ]
        }
      },
      "paraphrases": [
        "cpu for all austin devices last 3h",
        "aus boxes cpu past three hours",
        "every device in austin cpu last 3 hrs"
      ]
    },
    {
      "id": "devices-002",
      "category": "devices",
      "question": "Which devices are over 85% memory right now?",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "threshold",
        "entities": [],
        "ast": {
          "v": 1,
          "query_type": "metric_filter",
          "target": "device",
          "metric": "mem_util_pct",
          "aggregation": "avg",
          "predicate": {
            "op": "gt",
            "value": 85
          },
          "time_range": {
            "kind": "relative",
            "last": "5m"
          }
        },
        "alternates": [],
        "result_semantics": {
          "kind": "entity_rows",
          "must_include_refs": []
        }
      },
      "paraphrases": [
        "boxes above 85% mem now",
        "anything over 85 percent memory currently",
        "devices with memory > 85 right now"
      ]
    },
    {
      "id": "devices-003",
      "category": "devices",
      "question": "Show incidents affecting dfw-edge-1 this week.",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "list_incidents",
        "entities": [
          {
            "input": "dfw-edge-1",
            "type": "device",
            "id": "device:dfw-edge-1",
            "method": "discovery"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "incident_list",
          "target": "incident",
          "entities": [
            {
              "type": "device",
              "id": "device:dfw-edge-1"
            }
          ],
          "time_range": {
            "kind": "absolute",
            "from": "2026-09-21T05:00:00Z",
            "to": "2026-09-24T15:00:00Z"
          },
          "order_by": [
            {
              "field": "created_at",
              "dir": "desc"
            }
          ]
        },
        "alternates": [],
        "result_semantics": {
          "kind": "incident_rows",
          "must_include_refs": [
            "incident:3f2a9c1e-7b4d-4e8a-9c01-5d6e7f8a9b0c"
          ],
          "min_rows": 1
        }
      },
      "paraphrases": [
        "dfw-edge-1 incidents this week",
        "any outages involving DFW-EDGE-1 since monday",
        "incidents on dfw edge 1 this week"
      ]
    },
    {
