    {
      "id": "dns-003",
      "category": "dns",
      "question": "Show latency to the internal DNS server 10.20.0.53 for the last hour.",
      "context": {
        "tz": "America/Chicago",
        "cross": true
      },
      "expect": {
        "intent": "show_metric",
        "entities": [
          {
            "input": "10.20.0.53",
            "type": "probe_target",
            "id": "probe:10.20.0.53",
            "method": "label_pair"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "metric_series",
          "target": "probe_target",
          "metric": "probe_rtt_ms",
          "aggregation": "p95",
          "entities": [
            {
              "type": "probe_target",
              "id": "probe:10.20.0.53"
            }
          ],
          "time_range": {
            "kind": "relative",
            "last": "1h"
          }
        },
        "alternates": [],
        "result_semantics": {
          "kind": "timeseries",
          "must_include_refs": [
            "probe:10.20.0.53"
          ]
        }
      },
      "paraphrases": [
        "rtt to 10.20.0.53 last hour",
        "internal dns 10.20.0.53 latency past 60m",
        "latency to our dns server 10.20.0.53 last 1h"
      ]
    },
