        ],
        "ast": {
          "v": 1,
          "query_type": "compare_windows",
          "target": "probe_target",
          "metric": "probe_rtt_ms",
          "aggregation": "p95",
          "entities": [
            {
              "type": "probe_target",
              "id": "probe:1.1.1.1"
            }
          ],
          "time_range": {
            "kind": "absolute",
            "from": "2026-09-24T05:00:00Z",
            "to": "2026-09-24T15:00:00Z"
          },
          "compare_to": {
            "kind": "absolute",
            "from": "2026-09-23T05:00:00Z",
            "to": "2026-09-23T15:00:00Z"
          }
        },
        "alternates": [],
        "result_semantics": {
          "kind": "comparison",
          "must_include_refs": [
            "probe:1.1.1.1"
          ]
        }
      },
      "paraphrases": [
        "1.1.1.1 rtt today vs yesterday",
        "latency to cloudflare dns today compared with yesterday",
