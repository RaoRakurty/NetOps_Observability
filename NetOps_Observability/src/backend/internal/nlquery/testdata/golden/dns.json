{
  "schema": "correlix.nlquery.golden/v1",
  "category": "dns",
  "cases": [
    {
      "id": "dns-001",
      "category": "dns",
      "question": "Show DNS changes in the last week.",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "list_changes",
        "entities": [],
        "ast": {
          "v": 1,
          "query_type": "change_list",
          "target": "change",
          "filters": [
            {
              "field": "type",
              "op": "eq",
              "values": [
                "DNS_CHANGE"
              ]
            }
          ],
          "time_range": {
            "kind": "relative",
            "last": "7d"
          },
          "order_by": [
            {
              "field": "event_at",
              "dir": "desc"
            }
          ]
        },
        "alternates": [],
        "result_semantics": {
          "kind": "change_rows",
          "must_include_refs": [
            "change:chg-1046"
          ],
          "min_rows": 1
        }
      },
      "paraphrases": [
        "dns changes past week",
        "any dns edits last 7 days",
        "what changed in dns this past week"
      ]
    },
