    {
      "id": "grouping-001",
      "category": "grouping",
      "question": "Show changes grouped by site this week.",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "list_changes",
        "entities": [],
        "ast": {
          "v": 1,
          "query_type": "change_list",
          "target": "change",
          "time_range": {
            "kind": "absolute",
            "from": "2026-09-21T05:00:00Z",
            "to": "2026-09-24T15:00:00Z"
          },
          "group_by": [
            "site"
          ],
          "order_by": [
            {
              "field": "event_at",
              "dir": "desc"
            }
          ]
        },
        "alternates": [],
        "result_semantics": {
          "kind": "group_counts",
          "must_include_refs": [
            "change:chg-1042",
            "change:chg-1050"
          ],
          "min_rows": 10
        }
      },
      "paraphrases": [
        "changes by site this week",
        "per-site changes since monday",
        "group this week's changes by site"
      ]
    },
