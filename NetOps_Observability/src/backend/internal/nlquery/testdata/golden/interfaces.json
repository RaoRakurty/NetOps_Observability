{
  "schema": "correlix.nlquery.golden/v1",
  "category": "interfaces",
  "cases": [
    {
      "id": "interfaces-001",
      "category": "interfaces",
      "question": "Show utilization on dfw-edge-1 ge-0/0/0 for the last 4 hours.",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "show_metric",
        "entities": [
          {
            "input": "dfw-edge-1 ge-0/0/0",
            "type": "interface",
            "id": "interface:dfw-edge-1/ge-0/0/0",
            "method": "label_pair"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "metric_series",
          "target": "interface",
          "metric": "if_util_max_pct",
          "aggregation": "max",
          "entities": [
            {
              "type": "interface",
              "id": "interface:dfw-edge-1/ge-0/0/0"
            }
          ],
          "time_range": {
            "kind": "relative",
            "last": "4h"
          }
        },
        "alternates": [
          {
            "v": 1,
            "query_type": "metric_series",
            "target": "interface",
            "metric": "if_util_in_pct",
            "aggregation": "avg",
            "entities": [
              {
                "type": "interface",
                "id": "interface:dfw-edge-1/ge-0/0/0"
              }
            ],
            "time_range": {
              "kind": "relative",
              "last": "4h"
            }
          },
          {
            "v": 1,
            "query_type": "metric_series",
            "target": "interface",
            "metric": "if_util_out_pct",
            "aggregation": "avg",
            "entities": [
              {
                "type": "interface",
                "id": "interface:dfw-edge-1/ge-0/0/0"
              }
            ],
            "time_range": {
              "kind": "relative",
              "last": "4h"
            }
          }
        ],
        "result_semantics": {
          "kind": "timeseries",
          "must_include_refs": [
            "interface:dfw-edge-1/ge-0/0/0"
          ]
        }
      },
      "paraphrases": [
        "util dfw-edge-1 ge-0/0/0 last 4h",
        "how busy is ge-0/0/0 on DFW-EDGE-1 past 4 hours",
        "dfw edge 1 ge-0/0/0 utilization last four hours"
      ]
    },
