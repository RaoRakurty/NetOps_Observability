    {
      "id": "metrics-001",
      "category": "metrics",
      "question": "Show CPU on dfw-edge-1 for the last hour.",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "show_metric",
        "entities": [
          {
            "input": "dfw-edge-1",
            "type": "device",
            "id": "device:dfw-edge-1",
            "method": "discovery"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "metric_series",
          "target": "device",
          "metric": "cpu_util_pct",
          "aggregation": "avg",
          "entities": [
            {
              "type": "device",
              "id": "device:dfw-edge-1"
            }
          ],
          "time_range": {
            "kind": "relative",
            "last": "1h"
          }
        },
        "alternates": [],
        "result_semantics": {
          "kind": "timeseries",
          "must_include_refs": [
            "device:dfw-edge-1"
          ]
        }
      },
      "paraphrases": [
        "cpu dfw-edge-1 last hour",
        "how's the cpu on DFW-EDGE-1 over the past 60 min",
        "dfw-edge-1 cpu past hour"
      ]
    },
