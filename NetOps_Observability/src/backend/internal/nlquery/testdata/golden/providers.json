{
  "schema": "correlix.nlquery.golden/v1",
  "category": "providers",
  "cases": [
    {
      "id": "providers-001",
      "category": "providers",
      "question": "Show loss on Comcast circuits for the last hour.",
      "context": {
        "tz": "America/Chicago",
        "cross": true
      },
      "expect": {
        "intent": "show_metric",
        "entities": [
          {
            "input": "Comcast",
            "type": "provider",
            "id": "provider:comcast",
            "method": "alias_table"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "metric_series",
          "target": "circuit",
          "metric": "circuit_loss_pct",
          "aggregation": "avg",
          "entities": [
            {
              "type": "provider",
              "id": "provider:comcast"
            }
          ],
          "time_range": {
            "kind": "relative",
            "last": "1h"
          }
        },
        "alternates": [],
        "result_semantics": {
          "kind": "timeseries",
          "must_include_refs": [
            "circuit:dfw-comcast-1",
            "circuit:aus-comcast-1",
            "circuit:sjc-comcast-1"
          ]
        }
      },
      "paraphrases": [
        "comcast loss last hour",
        "packet loss on all comcast links past 60m",
        "comcast circuit loss last 1h"
      ]
    },
