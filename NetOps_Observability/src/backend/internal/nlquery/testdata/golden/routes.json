    {
      "id": "routes-003",
      "category": "routes",
      "question": "Show routes received from each BGP peer on nyc-edge-1 for the last 6 hours.",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "show_metric",
        "entities": [
          {
            "input": "nyc-edge-1",
            "type": "device",
            "id": "device:nyc-edge-1",
            "method": "discovery"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "metric_series",
          "target": "bgp_peer",
          "metric": "bgp_prefixes_received",
          "aggregation": "last",
          "entities": [
            {
              "type": "device",
              "id": "device:nyc-edge-1"
            }
          ],
          "time_range": {
            "kind": "relative",
            "last": "6h"
          }
        },
        "alternates": [],
        "result_semantics": {
          "kind": "timeseries",
          "must_include_refs": [
            "bgp_peer:nyc-edge-1/169.254.10.1@aws-dx",
            "bgp_peer:nyc-edge-1/198.51.100.77"
          ]
        }
      },
      "paraphrases": [
        "received routes per peer on nyc-edge-1 last 6h",
        "prefix counts for NYC-EDGE-1 neighbors past six hours",
        "routes received nyc edge peers last 6 hrs"
      ]
    },
