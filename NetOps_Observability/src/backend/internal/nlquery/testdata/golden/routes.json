    {
      "id": "routes-001",
      "category": "routes",
      "question": "Show routing changes in the last 24 hours.",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "list_changes",
        "entities": [],
        "ast": {
          "v": 1,
          "query_type": "change_list",
          "target": "change",
          "filters": [
            {
              "field": "type",
              "op": "eq",
              "values": [
                "ROUTE_CHANGE"
              ]
            }
          ],
          "time_range": {
            "kind": "relative",
            "last": "24h"
          },
          "order_by": [
            {
              "field": "event_at",
              "dir": "desc"
            }
          ]
        },
        "alternates": [],
        "result_semantics": {
          "kind": "change_rows",
          "must_include_refs": [
            "change:chg-1042"
          ],
          "min_rows": 1
        }
      },
      "paraphrases": [
        "route changes last 24h",
        "any routing policy changes past day",
        "routing changes in the last day"
      ]
    },
