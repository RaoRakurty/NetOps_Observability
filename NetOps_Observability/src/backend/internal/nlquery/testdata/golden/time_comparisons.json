    {
      "id": "time_comparisons-001",
      "category": "time_comparisons",
      "question": "Compare CPU on dfw-edge-1 with yesterday.",
      "context": {
        "tz": "America/Chicago"
      },
      "expect": {
        "intent": "compare",
        "entities": [
          {
            "input": "dfw-edge-1",
            "type": "device",
            "id": "device:dfw-edge-1",
            "method": "discovery"
          }
        ],
        "ast": {
          "v": 1,
          "query_type": "compare_windows",
          "target": "device",
          "metric": "cpu_util_pct",
          "aggregation": "avg",
          "entities": [
            {
              "type": "device",
              "id": "device:dfw-edge-1"
            }
          ],
          "time_range": {
            "kind": "relative",
            "last": "1h"
          },
          "compare_to": {
            "kind": "relative",
            "last": "1h",
            "offset": "1d"
          }
        },
        "alternates": [],
        "result_semantics": {
          "kind": "comparison",
          "must_include_refs": [
            "device:dfw-edge-1"
          ]
        }
      },
      "paraphrases": [
        "dfw-edge-1 cpu vs yesterday",
        "cpu on DFW-EDGE-1 compared to this time yesterday",
        "compare dfw edge 1 cpu with yesterday"
      ]
    },
