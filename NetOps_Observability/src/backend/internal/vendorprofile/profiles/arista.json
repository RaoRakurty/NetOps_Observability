{
  "schema_version": 1,
  "vendor": "arista",
  "display_name": "Arista Networks",
  "notes": "The telemetry catalog names this platform 'ceos' (the containerized EOS in the lab); 'ceos' is a platform ALIAS of the eos profile, not a second product. internal/hardening ships NO Arista bindings today, so the hardening binding is deliberately empty (rules report NotApplicable, never a false Pass). The CLI binding is deliberately cisco-iosxe: EOS speaks the Cisco IOS-XE show-command grammar, which is why the protocol-diagnostics catalog renders EOS devices in that dialect. That is a SHOW-GRAMMAR claim only and is a separate axis from the (empty) hardening binding above.",
  "detection": {
    "sysobjectid_prefixes": [
      "1.3.6.1.4.1.30065"
    ],
    "sysdescr_contains": [
      "arista"
    ],
    "sysdescr_rank": 30,
    "os_version_pattern": "(?i)\\bversion[ :]+([0-9][0-9A-Za-z.-]*)"
  },
  "dialect": {
    "vrf_term": "VRF",
    "vrf_term_keys": [
      "arista",
      "eos"
    ],
    "vrf_synonyms": [
      "vrf"
    ]
  },
  "verify": {
    "commands": {
      "ssh_bgp_edge": "show ip bgp summary vrf all",
      "ssh_config_change": "show running-config diffs",
      "ssh_iface_deep": "show interfaces",
      "ssh_interfaces": "show interfaces status",
      "ssh_routing": "show ip bgp summary"
    }
  },
  "profiles": [
    {
      "platform": "eos",
      "display_name": "Arista EOS",
      "device_class": [
        "switch",
        "router"
      ],
      "fidelity": "live_validated",
      "detection": {
        "os_parse": {
          "product": "eos",
          "rank": 10,
          "sysdescr_contains_any": []
        },
        "platform_contains": [
          "arista",
          "eos",
          "ceos"
        ],
        "platform_rank": 40,
        "syslog_facilities": [
          "SYS"
        ]
      },
      "capture": {
        "running_config_cmd": "show running-config",
        "show_version_cmd": "show version",
        "pager_off_cmds": [
          "terminal length 0"
        ],
        "prompt_regex": "(?m)^[A-Za-z0-9._-]+[>#]\\s*$",
        "pcap_start_cmd": [
          "bash timeout {secs} tcpdump -i {iface} -c {count} -s 0 -U -w /mnt/flash/{file}.pcap[ '{filter}']"
        ],
        "pcap_cleanup_cmd": [
          "bash rm -f /mnt/flash/{file}.pcap"
        ],
        "pcap_remote_path": "/mnt/flash/{file}.pcap",
        "pcap_supports_filter": true
      },
      "advisory": {
        "provider": "offline-feed",
        "product_ids": [
          "eos"
        ]
      },
      "hardening": {},
      "cli": {
        "dialect": "cisco-iosxe",
        "display": "Cisco IOS-XE"
      },
      "threat": {
        "log_rule_ids": [
          "log-logging-disabled",
          "log-buffer-cleared",
          "log-offhours-config-change",
          "log-new-local-user",
          "log-privilege-escalation",
          "log-gre-tunnel",
          "log-aaa-tampering",
          "log-boot-image-change"
        ],
        "mnemonic_prefixes": [
          "SYS"
        ]
      },
      "platform_aliases": [
        "ceos"
      ]
    }
  ]
}
