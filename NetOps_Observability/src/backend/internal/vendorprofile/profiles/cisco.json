{
  "schema_version": 1,
  "vendor": "cisco",
  "display_name": "Cisco",
  "notes": "os_parse ranks reproduce collectors.ciscoProduct exactly: IOS-XR and IOS-XE sysDescrs also contain the bare 'ios', so the family markers must be evaluated before it. No unconditional default: a Cisco sysDescr naming no family yields product \"\" (version still parsed) — honest, not a guess.",
  "detection": {
    "sysobjectid_prefixes": [
      "1.3.6.1.4.1.9"
    ],
    "sysdescr_contains": [
      "cisco"
    ],
    "sysdescr_rank": 10,
    "os_version_pattern": "(?i)\\bVersion[ :]+([0-9][0-9A-Za-z.()-]*)"
  },
  "dialect": {
    "vrf_term": "VRF",
    "vrf_term_keys": [
      "cisco",
      "ios",
      "iosxe",
      "iosxr",
      "nxos"
    ],
    "vrf_synonyms": [
      "vrf",
      "vrf-lite"
    ]
  },
  "verify": {
    "commands": {
      "ssh_bgp_edge": "show bgp all summary",
      "ssh_config_change": "show running-config",
      "ssh_iface_deep": "show interfaces",
      "ssh_interfaces": "show ip interface brief",
      "ssh_routing": "show ip bgp summary"
    }
  },
  "config_capture": {
    "platform_contains": [
      "cisco",
      "ios-xe",
      "iosxe",
      "ios xe",
      "ios-xr",
      "iosxr",
      "nx-os",
      "nxos"
    ],
    "platform_rank": 20,
    "running_config_cmd": "show running-config",
    "volatile_rules": [
      {
        "name": "building-config",
        "pattern": "(?i)^\\s*building configuration"
      },
      {
        "name": "current-config",
        "pattern": "(?i)^\\s*current configuration\\s*:"
      },
      {
        "name": "last-change",
        "pattern": "(?i)^\\s*!\\s*last configuration change"
      },
      {
        "name": "nvram-updated",
        "pattern": "(?i)^\\s*!\\s*nvram config last updated"
      },
      {
        "name": "ntp-clock-period",
        "pattern": "(?i)^\\s*ntp clock-period\\s+\\d+"
      },
      {
        "name": "time-stamp",
        "pattern": "(?i)^\\s*!\\s*time\\s*:"
      }
    ]
  },
  "snmp_configgen": {
    "v2c_template": "snmp-server community <<community>> RO",
    "v3_template": "snmp-server group CORRELIX v3 priv\nsnmp-server user <<sec_name>> CORRELIX v3 auth sha <<auth_key>> priv aes 128 <<priv_key>>"
  },
  "device_type": {
