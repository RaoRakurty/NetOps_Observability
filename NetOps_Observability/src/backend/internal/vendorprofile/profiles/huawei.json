{
  "schema_version": 1,
  "vendor": "huawei",
  "display_name": "Huawei",
  "notes": "VRP declares NO cli dialect: the protocol-diagnostics catalog ships no Huawei command bindings, so a Huawei device's dialect is honestly unknown there (the caller records the fallback it renders). The vendor-level verify.commands block IS established — the active-verification battery has authored VRP display-command rows.",
  "detection": {
    "sysobjectid_prefixes": [
      "1.3.6.1.4.1.2011"
    ],
    "sysdescr_contains": [
      "huawei",
      "vrp"
    ],
    "sysdescr_rank": 70,
    "os_version_pattern": "(?i)\\bVersion[ :]+([0-9][0-9A-Za-z.]*)"
  },
  "dialect": {
    "vrf_term": "VPN instance",
    "vrf_term_keys": [
      "huawei",
      "vrp"
    ],
    "vrf_synonyms": [
      "vpn-instance"
    ]
  },
  "verify": {
    "commands": {
      "ssh_bgp_edge": "display bgp peer",
      "ssh_config_change": "display configuration commit list",
      "ssh_iface_deep": "display interface",
      "ssh_interfaces": "display interface brief",
      "ssh_routing": "display bgp peer"
    }
  },
  "profiles": [
    {
      "platform": "vrp",
      "display_name": "Huawei VRP",
      "device_class": [
        "router",
        "switch"
      ],
      "fidelity": "doc_claimed",
      "detection": {
        "os_parse": {
          "product": "vrp",
          "rank": 10,
          "sysdescr_contains_any": []
        },
        "platform_contains": [
          "huawei",
          "vrp"
        ],
        "platform_rank": 50
      },
      "capture": {
        "running_config_cmd": "display current-configuration",
        "show_version_cmd": "display version",
        "pager_off_cmds": [
          "screen-length 0 temporary"
        ],
        "prompt_regex": "(?m)^[<\\[][A-Za-z0-9._-]+[>\\]]\\s*$"
      },
      "advisory": {
        "provider": "offline-feed",
        "product_ids": [
          "vrp"
        ]
      },
      "hardening": {},
      "threat": {}
    }
  ]
}
