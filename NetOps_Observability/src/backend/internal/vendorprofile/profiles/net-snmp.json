      "device_class": [
        "host"
      ],
      "fidelity": "doc_claimed",
      "detection": {
        "os_parse": {
          "product": "linux_kernel",
          "rank": 10,
          "sysdescr_contains_any": []
        }
      },
      "capture": {},
