{
  "schema_version": 1,
  "vendor": "net-snmp",
  "display_name": "Net-SNMP",
  "notes": "Net-SNMP is a DISTINCT detection identity (its own enterprise number) that reports the same linux_kernel product as the linux vendor. The duplication is deliberate: collapsing them would change what DetectVendor returns.",
