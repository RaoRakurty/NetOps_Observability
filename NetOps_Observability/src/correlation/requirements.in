# Direct dependencies for the correlation service (SC-011). This is the human-
# edited source of truth; the pinned, hash-locked requirements.txt is generated:
#
#   pip-compile --generate-hashes --output-file=requirements.txt requirements.in
#
# requirements.txt is what the Dockerfile/CI install (with --require-hashes
# enforced automatically by the presence of hashes).
fastapi==0.133.1
# SC-005: starlette pinned >=1.0.1 to clear PYSEC-2026-161 / CVE-2025-62727 /
# CVE-2025-54121 (fastapi 0.133.1 is the first to allow the starlette 1.x line).
# Bumped 1.0.1 -> 1.3.1 for CVE-2026-48818 (StaticFiles UNC-path SSRF) and
# CVE-2026-54283 (urlencoded form limits ignored -> DoS).
starlette==1.3.1
uvicorn[standard]==0.30.6
aiokafka==0.11.0
# Snappy codec for aiokafka: the flows topic arrives snappy-compressed and the
# missing codec KILLED the consumer at first fetch (UnsupportedCodecError —
# found at #67 build ⑥; this was the engine-starvation root cause). cramjam
# ships pure wheels (no native libsnappy), hence preferred over python-snappy.
cramjam==2.8.4
# SC-005: anyio is transitive (httpx, starlette, watchfiles) but pinned here so
# the fix cannot be un-picked by a later resolve. 4.13.0 -> 4.14.2 clears
# CVE-2026-63374 (TLSStream encoded host names with IDNA 2003, so a look-alike
# name could be accepted against a certificate issued for another host — TLS
# certificate spoofing, CRITICAL) and CVE-2026-64847.
anyio==4.14.2
